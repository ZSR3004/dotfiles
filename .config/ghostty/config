###############
### STARTUP ###
###############

command = /opt/homebrew/bin/tmux new-session -A -s main


############
### FONT ###
############

font-family = JetBrainsMonoNerdFont
font-size = 13
font-thicken = true

font-feature = liga
font-feature = calt
font-feature = dlig


##############
### Window ###
##############

window-padding-x = 3
window-padding-y = 5

confirm-close-surface = false


#############
### Theme ###
#############

background-opacity = 0.9
background = 181818
theme = Carbonfox
cursor-style = block


########################
### TABS AND WINDOWS ###
########################

resize-overlay = never
gtk-tabs-location = hidden
gtk-single-instance = false


################
### KEYBINDS ###
################

keybind = clear

# Font Size / Zoom
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Clipboard
keybind = performable:cmd+c=copy_to_clipboard
keybind = performable:cmd+shift+p=paste_from_clipboard
